    Dispatcher --> Transport
    Transport --> NodeDB
    Transport --> NodeWeather
    Transport --> NodeFS
    Transport --> NodeDelivery
    Transport --> NodeBooking
    
    Dispatcher -.-> Profiler
    FSM -.-> Engine

