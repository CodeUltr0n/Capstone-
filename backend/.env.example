# Copy to backend/.env and replace all example secrets before running.
ORCHESTRATOR_API_KEY=replace-with-a-long-random-secret

# Omit to use local SQLite. Set a PostgreSQL URL to share state across instances.
# ORCHESTRATOR_DATABASE_URL=postgresql://user:password@host:5432/orchestrator

# Optional JSON map of registered server IDs to HTTP headers; keep values secret.
# MCP_SERVER_HEADERS_JSON={"server-id":{"Authorization":"Bearer replace-me"}}

MCP_REQUEST_TIMEOUT=45
MCP_TOOL_CACHE_TTL=30
MCP_MAX_PARALLEL_DISCOVERY=10
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional OpenAI Responses-compatible model routing. If unset, routing stays lexical.
# The user's task and shortlisted tool descriptions/schemas are sent to this provider.
# ORCHESTRATOR_LLM_API_KEY=replace-with-provider-key
# ORCHESTRATOR_LLM_MODEL=your-tool-calling-model
# ORCHESTRATOR_LLM_BASE_URL=https://api.openai.com/v1
